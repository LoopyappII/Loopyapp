# Stripe — pegar los valores reales del dashboard de Stripe del cliente
# (Looper Cashline SL). Nunca commitear el archivo .env.local real.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Supabase service_role key — Project Settings > API en el dashboard de
# Supabase del proyecto de Loopy (xumacwfsabojqefhaozm). Server-only,
# nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Emails que pueden crear/usar Loopys sin pasar por el pago real de
# Stripe — separados por coma, sin espacios extra necesarios (se
# recortan igual). Solo para pruebas internas o cuentas de
# administración; dejar vacío en producción hasta decidir qué email(s)
# usar. Ver lib/adminBypass.ts.
ADMIN_BYPASS_EMAILS=

# Emails del STAFF de Looper Cashline SL con acceso al panel de
# administración /admin (ver todos los clientes/Loopys, cancelar
# suscripciones, eliminar Loopys) — separados por coma, mismo formato que
# ADMIN_BYPASS_EMAILS. Sin relación con ese allowlist: un email puede estar
# en uno, en el otro, en ambos o en ninguno. Ver lib/backofficeAuth.ts.
BACKOFFICE_STAFF_EMAILS=

